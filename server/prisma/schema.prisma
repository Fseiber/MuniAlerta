datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Gravedad {
  LEVE
  MODERADO
  GRAVE
}

enum EstadoReporte {
  PENDIENTE
  EN_REVISION
  RESUELTO
}

enum Categoria {
  ANEGAMIENTO
  ARBOLADO
  BASURA_CLOACAS
  VIAL
  LUMINARIA
  SEMAFORO
  CABLE_ELECTRICO
}

enum EstadoSello {
  SIN_SELLO
  PENDIENTE
  ANCLADO
  ERROR
}

enum TipoEventoSello {
  CREACION
  CAMBIO_ESTADO
  VALIDACION
}

model Reporte {
  id             Int           @id @default(autoincrement())
  expedienteDoco String        @unique
  latitud        Float
  longitud       Float
  barrio         String?
  trazado        Json?
  radioCharcoM   Int?
  cuadrilla      String?
  descripcion    String
  gravedad       Gravedad      @default(MODERADO)
  esTransitable  Boolean?
  estado         EstadoReporte @default(PENDIENTE)
  esDemo         Boolean       @default(false)
  umbralLluvia   Int?
  fechaCreacion  DateTime      @default(now())
  categoria      Categoria     @default(ANEGAMIENTO)
  categoriaSugeridaIa Categoria?
  resumenIa      String?
  fotoHash       String?
  cuentaId       String?
  validado       Boolean       @default(false)
  fechaValidacion DateTime?
  confirmaciones Int           @default(1)
  zonaCritica    Boolean       @default(false)
  esSemilla      Boolean       @default(false)
  eventosSello   EventoSello[]
}

model EventoSello {
  id                  Int             @id @default(autoincrement())
  reporteId           Int
  reporte             Reporte         @relation(fields: [reporteId], references: [id], onDelete: Cascade)
  tipo                TipoEventoSello
  estadoNuevo         String?
  hash                String
  hashPrevio          String?
  selloEstado         EstadoSello     @default(PENDIENTE)
  hederaTransactionId String?
  hederaSecuencia     Int?
  tiempoConsenso      String?
  intentos            Int             @default(0)
  ultimoError         String?
  creadoEn            DateTime        @default(now())

  @@index([reporteId, creadoEn])
}
